{
  "name": "@salesforce/b2c-dx-docs",
  "version": "0.3.23",
  "private": true,
  "type": "module",
  "description": "Documentation for B2C Developer Tooling",
  "scripts": {
    "lint": "eslint .vitepress/releases",
    "lint:agent": "eslint --quiet .vitepress/releases",
    "format:releases": "prettier --write .vitepress/releases/*.ts .vitepress/theme/ReleaseFeed.vue",
    "releases:refresh": "tsx .vitepress/releases/refresh.ts",
    "test:releases": "tsc -p .vitepress/releases/tsconfig.json && tsx --test .vitepress/releases/history.test.ts",
    "docs:api": "typedoc",
    "docs:dev": "pnpm run docs:api && vitepress dev",
    "docs:build": "pnpm run docs:api && vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@salesforce/b2c-tooling-sdk": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-header": "catalog:",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "tsx": "catalog:",
    "typedoc": "^0.28.14",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-group-icons": "^1.7.5"
  }
}
