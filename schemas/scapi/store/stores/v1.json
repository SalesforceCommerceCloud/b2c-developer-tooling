        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "Select": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[(].*[)]$"
      },
      "Total": {
        "type": "integer",
        "format": "int32",
        "default": 0,
        "minimum": 0
