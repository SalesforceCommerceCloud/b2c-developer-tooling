{
  "openapi": "3.0.3",
  "info": {
    "title": "Shopper Stores",
    "version": "1.4.0",
    "x-api-type": "Shopper",
    "x-api-family": "Store"
  },
  "servers": [
    {
      "url": "https://{shortCode}.api.commercecloud.salesforce.com/store/shopper-stores/v1",
      "variables": {
        "shortCode": {
          "default": "shortCode"
        }
      }
    }
  ],
  "paths": {
    "/organizations/{organizationId}/stores": {
      "get": {
        "operationId": "getStores",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/LocaleCode"
            }
          },
          {
            "name": "sfdc_usid",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sfdc_dw_dnt",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "personalized",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          {
            "name": "sfdc_shopper_context",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned details for specific stores.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreResult"
                }
              }
            }
          },
          "400": {
            "description": "A value constraint for query parameters was violated. Or, a combination of latitude and longitude, a combination of country code and postal code, or an invalid distance_unit was provided.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ShopperToken": [
              "sfcc.shopper-stores",
              "sfcc.shopper-standard"
            ]
          },
          {
            "ShopperClientContextToken": [
              "sfcc.shopper-stores",
              "sfcc.shopper-standard"
            ]
          }
        ]
      }
    },
    "/organizations/{organizationId}/store-search": {
      "get": {
        "operationId": "searchStores",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/CountryCode"
            }
          },
          {
            "name": "distanceUnit",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/DistanceUnit"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Latitude"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Longitude"
            }
          },
          {
            "name": "maxDistance",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Distance"
            }
          },
          {
            "name": "postalCode",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/PostalCode"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/LocaleCode"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25,
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "sfdc_usid",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sfdc_dw_dnt",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "personalized",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          {
            "name": "sfdc_shopper_context",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned a list of stores for the given search parameters, up to the paging size, including their distance from the given geolocation and additional information on the pagination of objects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stores"
                }
              }
            }
          },
          "400": {
            "description": "A value constraint for query parameters was violated. Or, a combination of latitude and longitude, a combination of country code and postal code, or an invalid distance_unit was provided.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ShopperToken": [
              "sfcc.shopper-stores",
              "sfcc.shopper-standard"
            ]
          },
          {
            "ShopperClientContextToken": [
              "sfcc.shopper-stores",
              "sfcc.shopper-standard"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OrganizationId": {
        "type": "string",
        "pattern": "^f_ecom_[a-z]{4}_(prd|stg|dev|s[0-9]{2}|[0-9]{3})$"
      },
      "SiteId": {
        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "LanguageCountry": {
        "type": "string",
        "pattern": "^[a-z][a-z]-[A-Z][A-Z]$"
      },
      "LanguageCode": {
        "type": "string",
        "pattern": "^[a-z][a-z]$"
      },
      "DefaultFallback": {
        "type": "string",
        "default": "default",
        "pattern": "^default$"
      },
      "LocaleCode": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/LanguageCountry"
          },
          {
            "$ref": "#/components/schemas/LanguageCode"
          },
          {
            "$ref": "#/components/schemas/DefaultFallback"
          }
        ]
      },
      "Total": {
        "type": "integer",
        "format": "int32",
        "default": 0,
        "minimum": 0
      },
      "ResultBase": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "$ref": "#/components/schemas/Total"
          }
        },
        "required": [
          "limit",
          "total"
        ]
      },
      "CountryCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z]$"
      },
      "Distance": {
        "type": "number",
        "format": "double",
        "maximum": 20012,
        "minimum": 0
      },
      "DistanceUnit": {
        "type": "string",
        "enum": [
          "km",
          "mi"
        ]
      },
      "Latitude": {
        "type": "number",
        "format": "double",
        "maximum": 90,
        "minimum": -90
      },
      "Longitude": {
        "type": "number",
        "format": "double",
        "maximum": 180,
        "minimum": -180
      },
      "PostalCode": {
        "type": "string",
        "maxLength": 10,
        "minLength": 3
      },
      "Store": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "minLength": 1
          },
          "address2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "countryCode": {
            "$ref": "#/components/schemas/CountryCode"
          },
          "distance": {
            "$ref": "#/components/schemas/Distance"
          },
          "distanceUnit": {
            "$ref": "#/components/schemas/DistanceUnit"
          },
          "email": {
            "type": "string"
          },
          "fax": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "image": {
            "type": "string"
          },
          "inventoryId": {
            "type": "string",
            "maxLength": 256
          },
          "latitude": {
            "$ref": "#/components/schemas/Latitude"
          },
          "longitude": {
            "$ref": "#/components/schemas/Longitude"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "posEnabled": {
            "type": "boolean"
          },
          "postalCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostalCode"
              }
            ]
          },
          "stateCode": {
            "type": "string"
          },
          "storeEvents": {
            "type": "string"
          },
          "storeHours": {
            "type": "string"
          },
          "storeLocatorEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      },
      "StoreResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResultBase"
          }
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Store"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 2048
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "detail",
          "title",
          "type"
        ]
      },
      "Offset": {
        "type": "integer",
        "format": "int32",
        "default": 0,
        "minimum": 0
      },
      "PaginatedResultBase": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResultBase"
          }
        ],
        "properties": {
          "offset": {
            "$ref": "#/components/schemas/Offset"
          }
        },
        "required": [
          "limit",
          "offset",
          "total"
        ]
      },
      "Stores": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedResultBase"
          }
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Store"
            }
          }
        }
      }
    },
    "parameters": {
      "organizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "$ref": "#/components/schemas/OrganizationId"
        }
      },
      "ids": {
        "name": "ids",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "siteId": {
        "name": "siteId",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/SiteId"
        }
      },
      "locale": {
        "name": "locale",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/LocaleCode"
        }
      },
      "countryCode": {
        "name": "countryCode",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/CountryCode"
        }
      },
      "distanceUnit": {
        "name": "distanceUnit",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/DistanceUnit"
        }
      },
      "latitude": {
        "name": "latitude",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/Latitude"
        }
      },
      "longitude": {
        "name": "longitude",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/Longitude"
        }
      },
      "maxDistance": {
        "name": "maxDistance",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/Distance"
        }
      },
      "postalCode": {
        "name": "postalCode",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/PostalCode"
        }
      },
      "sfdcUsid": {
        "name": "sfdc_usid",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "sfdcDwDnt": {
        "name": "sfdc_dw_dnt",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "personalized": {
        "name": "personalized",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "string",
          "enum": [
            "none"
          ]
        }
      },
      "sfdcShopperContext": {
        "name": "sfdc_shopper_context",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "ShopperToken": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token",
            "scopes": {
              "sfcc.shopper-stores": "Allows read operations on shopper-stores"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/authorize",
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token",
            "scopes": {
              "sfcc.shopper-stores": "Allows read operations on shopper-stores"
            }
          }
        }
      },
      "ShopperClientContextToken": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token?hint=client_context",
            "scopes": {
              "sfcc.shopper-stores": "Allows read operations on shopper-stores"
            }
          }
        }
      }
    }
  }
}
