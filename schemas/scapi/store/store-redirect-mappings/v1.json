        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://account.demandware.com/dw/oauth2/access_token",
            "scopes": {
              "sfcc.store-redirect-mappings": "Read access to store redirect mapping resources",
              "sfcc.store-redirect-mappings.rw": "Read and write access to store redirect mapping resources"
