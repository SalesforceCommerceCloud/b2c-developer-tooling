{
  "openapi": "3.0.3",
  "info": {
    "title": "Cors",
    "version": "1.1.0",
    "x-api-type": "Admin",
    "x-api-family": "Configuration"
  },
  "servers": [
    {
      "url": "https://{shortCode}.api.commercecloud.salesforce.com/configuration/cors/v1",
      "variables": {
        "shortCode": {
          "default": "shortCode"
        }
      }
    }
  ],
  "paths": {
    "/organizations/{organizationId}/cors": {
      "get": {
        "operationId": "getCorsPreferences",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CORS preferences for the given site returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorsPreferences"
                }
              }
            }
          }
        },
        "security": [
          {
            "AmOAuth2": [
              "sfcc.cors-preferences",
              "sfcc.cors-preferences.rw"
            ]
          }
        ]
      },
      "put": {
        "operationId": "updateCorsPreferences",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorsPreferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "CORS preferences for the given site replaced successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorsPreferences"
                }
              }
            }
          },
          "201": {
            "description": "CORS preferences successfully created for the given site.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorsPreferences"
                }
              }
            }
          },
          "400": {
            "description": "Possible reasons:\n- The clientId is missing.\n- The domain names in the origins list are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AmOAuth2": [
              "sfcc.cors-preferences.rw"
            ]
          }
        ]
      },
      "delete": {
        "operationId": "deleteCorsPreferences",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "CORS preferences for the given site deleted successfully."
          }
        },
        "security": [
          {
            "AmOAuth2": [
              "sfcc.cors-preferences.rw"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OrganizationId": {
        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "SiteId": {
        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "CorsClientPreferences": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "pattern": "^[-a-zA-Z0-9]+$"
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z_0-9][-.+a-zA-Z_0-9]+://[-.a-zA-Z_0-9]{1,253}$"
            }
          }
        },
        "required": [
          "clientId",
          "origins"
        ]
      },
      "CorsPreferences": {
        "type": "object",
        "properties": {
          "corsClientPreferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CorsClientPreferences"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 2048
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "detail",
          "title",
          "type"
        ]
      }
    },
    "parameters": {
      "organizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "$ref": "#/components/schemas/OrganizationId"
        }
      },
      "siteId": {
        "name": "siteId",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/SiteId"
        }
      }
    },
    "securitySchemes": {
      "AmOAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://account.demandware.com/dwsso/oauth2/access_token",
            "scopes": {
              "sfcc.cors-preferences": "CORS preferences READONLY scope",
              "sfcc.cors-preferences.rw": "CORS preferences scope"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://account.demandware.com/dwsso/oauth2/authorize",
            "tokenUrl": "https://account.demandware.com/dwsso/oauth2/access_token",
            "scopes": {
              "sfcc.cors-preferences": "CORS preferences READONLY scope",
              "sfcc.cors-preferences.rw": "CORS preferences scope"
            }
          }
        }
      }
    }
  },
  "x-sdk-classname": "CORSPreferences"
}
