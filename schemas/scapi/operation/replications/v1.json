          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/NotOnStagingInstanceErrorResponse"
            }
          }
        }
      },
      "400BadRequest_CreateProcess": {
        "description": "Bad Request. The request is malformed or contains invalid data.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/InvalidRequestBodyErrorResponse"
            }
          }
        }
