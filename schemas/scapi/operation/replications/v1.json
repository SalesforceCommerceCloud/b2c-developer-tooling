          "application/problem+json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FeedBasedPriceBookNotSupportedErrorResponse"
                },
                {
                  "$ref": "#/components/schemas/NotOnStagingInstanceErrorResponse"
                }
              ]
            }
          }
        }
      },
      "404NotFound_GetProcess": {
