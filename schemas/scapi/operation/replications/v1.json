          {
            "$ref": "#/components/schemas/ContentAssetPublishRequest"
          }
        ]
      },
      "PublishIdResponse": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/id"
          }
        },
        "required": [
          "id"
        ]
      },
      "InvalidRequestBodyErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        ]
