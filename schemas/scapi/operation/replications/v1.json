        "required": [
          "product"
        ]
      },
      "PriceTablePublishRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priceTable": {
            "type": "object",
            "properties": {
              "productId": {
                "$ref": "#/components/schemas/ProductId"
              },
              "priceBookId": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "priceBookId",
              "productId"
            ]
          }
        },
        "required": [
