            }
          }
        }
      },
      "403Forbidden": {
        "description": "Forbidden. Your access token is valid, but you don't have the required permissions to access the resource,\nor the Granular Replication feature is disabled.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/FeatureNotEnabledErrorResponse"
            }
          }
        }
