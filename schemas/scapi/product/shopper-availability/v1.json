        "minLength": 1
      },
      "InventoryId": {
        "type": "string",
        "maxLength": 256,
        "minLength": 1
      },
      "SiteId": {
        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "ats": {
            "type": "number",
            "format": "double"
          },
          "backorderable": {
