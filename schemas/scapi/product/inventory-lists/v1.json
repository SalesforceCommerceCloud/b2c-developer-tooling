  "components": {
    "schemas": {
      "OrganizationId": {
        "type": "string",
        "pattern": "^f_ecom_[a-z]{4}_(prd|stg|dev|s[0-9]{2}|[0-9]{3})$"
      },
      "ProductId": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1
      },
      "Select": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[(].*[)]$"
      },
      "ProductInventoryRecordAllocation": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "resetDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PreorderBackorderHandling": {
        "type": "string",
        "enum": [
          "none",
          "preorder",
          "backorder"
        ]
      },
      "ProductInventoryRecord": {
        "type": "object",
        "additionalProperties": {},
        "properties": {
          "productId": {
            "$ref": "#/components/schemas/ProductId"
          },
          "productName": {
            "type": "string",
            "maxLength": 256
          },
          "inventoryListId": {
            "type": "string",
            "maxLength": 256
          },
          "perpetualFlag": {
            "type": "boolean"
          },
          "allocation": {
            "$ref": "#/components/schemas/ProductInventoryRecordAllocation"
          },
          "inStockDate": {
            "type": "string",
            "format": "date-time"
          },
          "ats": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "stockLevel": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "quantityOnOrder": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "inventoryTurnover": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "preOrderBackOrderHandling": {
            "$ref": "#/components/schemas/PreorderBackorderHandling"
          },
          "preOrderBackOrderAllocation": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "productId"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 2048
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "detail",
          "title",
          "type"
        ]
      },
      "InventoryList": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "defaultInStock": {
            "type": "boolean"
          },
          "useBundleInventoryOnly": {
            "type": "boolean"
          },
          "onOrderInventoryEnabled": {
            "type": "boolean"
          },
          "creationDate": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "lastModified": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "assignedSites": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "readOnly": true
          }
        },
        "required": [
          "id"
        ]
      }
    },
