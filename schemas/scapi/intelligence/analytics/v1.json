          }
        ]
      },
      "MeasureFilter": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Filter"
          },
          {
            "type": "object",
            "properties": {
              "measure": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1
              }
            },
            "required": [
              "measure"
            ]
          }
        ]
      },
      "SortOrder": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "order"
        ]
      },
      "QueryRequest": {
        "type": "object",
        "properties": {
          "dimensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DimensionId"
            }
          },
          "measures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeasureId"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/DimensionFilter"
                },
                {
                  "$ref": "#/components/schemas/MeasureFilter"
                }
              ]
            }
          },
          "order": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dimensions",
          "measures"
        ]
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "subjectAreaId": {
            "allOf": [
