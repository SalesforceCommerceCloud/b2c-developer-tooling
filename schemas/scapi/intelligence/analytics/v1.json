          },
          "query": {
            "$ref": "#/components/schemas/QueryRequest"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DimensionId"
            }
          },
          "measures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeasureId"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "data",
          "dimensions",
          "fields",
          "measures",
          "query",
          "subjectAreaId"
        ]
