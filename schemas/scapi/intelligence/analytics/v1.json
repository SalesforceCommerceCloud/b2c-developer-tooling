            "maxLength": 1024,
            "minLength": 1
          },
          "type": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "MeasureId": {
        "type": "string",
        "maxLength": 256,
        "minLength": 1
      },
