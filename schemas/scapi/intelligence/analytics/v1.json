            }
          }
        }
      }
    },
    "parameters": {
      "organizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "$ref": "#/components/schemas/OrganizationId"
        }
      },
      "subjectAreaId": {
        "name": "subjectAreaId",
        "in": "path",
        "required": true,
        "style": "simple",
