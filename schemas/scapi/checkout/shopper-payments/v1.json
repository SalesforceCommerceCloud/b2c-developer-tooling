{
  "openapi": "3.0.3",
  "info": {
    "title": "Shopper Payments",
    "version": "1.6.0",
    "x-api-type": "Shopper",
    "x-api-family": "Checkout"
  },
  "servers": [
    {
      "url": "https://{shortCode}.api.commercecloud.salesforce.com/checkout/shopper-payments/v1",
      "variables": {
        "shortCode": {
          "default": "shortCode"
        }
      }
    }
  ],
  "paths": {
    "/organizations/{organizationId}/payment-configuration": {
      "get": {
        "operationId": "getPaymentConfiguration",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/CurrencyCode"
            }
          },
          {
            "name": "countryCode",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/CountryCode"
            }
          },
          {
            "name": "zoneId",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/ZoneId"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/Amount"
            }
          },
          {
            "name": "sfdc_usid",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sfdc_dw_dnt",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "personalized",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          {
            "name": "sfdc_shopper_context",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment configuration details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentConfiguration"
                }
              }
            }
          },
          "400": {
            "description": "Possible reasons:\n- the site ID is required and must not be null.\n- the specified currency is invalid (must be ISO 4217) or not\nsupported by the site.\n- the provided country code is invalid (must be 2 uppercase\nletters matching ISO 3166-1 alpha-2).\n- the provided zone ID is invalid (must match pattern\n[a-zA-Z0-9\\-_]{1,100}).\n- the provided amount is invalid (must be non-negative).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ShopperToken": [
              "sfcc.shopper-baskets-orders",
              "sfcc.shopper-baskets-orders.rw",
              "sfcc.shopper-standard"
            ]
          },
          {
            "ShopperClientContextToken": [
              "sfcc.shopper-baskets-orders",
              "sfcc.shopper-baskets-orders.rw",
              "sfcc.shopper-standard"
            ]
          }
        ]
      }
    },
    "/organizations/{organizationId}/payment-instruments/balance": {
      "post": {
        "operationId": "getPaymentInstrumentBalance",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/OrganizationId"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/SiteId"
            }
          },
          {
            "name": "sfdc_usid",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sfdc_dw_dnt",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "sfdc_shopper_context",
            "in": "header",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentInstrumentBalanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Payment instrument balance retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentInstrumentBalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Possible reasons:\n- the provided payment method is invalid or not applicable.\n- the gift card details are invalid or missing when paymentMethodId is GIFT_CERTIFICATE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ShopperToken": [
              "sfcc.shopper-baskets-orders",
              "sfcc.shopper-baskets-orders.rw",
              "sfcc.shopper-standard"
            ]
          },
          {
            "ShopperClientContextToken": [
              "sfcc.shopper-baskets-orders",
              "sfcc.shopper-baskets-orders.rw",
              "sfcc.shopper-standard"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OrganizationId": {
        "type": "string",
        "pattern": "^f_ecom_[a-z]{4}_(prd|stg|dev|s[0-9]{2}|[0-9]{3})$"
      },
      "SiteId": {
        "type": "string",
        "maxLength": 32,
        "minLength": 1
      },
      "CurrencyCode": {
        "type": "string",
        "pattern": "^([A-Z][A-Z][A-Z]|N/A)$"
      },
      "CountryCode": {
        "type": "string",
        "pattern": "^[A-Z][A-Z]$"
      },
      "ZoneId": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1
      },
      "Amount": {
        "type": "number",
        "format": "double",
        "minimum": 0
      },
      "PaymentConfiguration": {
        "type": "object",
        "properties": {
          "zoneId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9\\-_]{1,100}$"
          },
          "paymentMethodSetAccounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountId": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "config": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "key": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "bnCode": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "country": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "paymentMethods": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "live": {
                  "type": "boolean"
                },
                "vendor": {
                  "type": "string"
                }
              },
              "required": [
                "accountId",
                "live",
                "vendor"
              ]
            }
          },
          "paymentMethods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "paymentMethodType": {
                  "type": "string"
                },
                "paymentModes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "accountId",
                "paymentMethodType",
                "paymentModes"
              ]
            }
          }
        },
        "required": [
          "paymentMethodSetAccounts",
          "paymentMethods"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "maxLength": 2048
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "detail",
          "title",
          "type"
        ]
      },
      "GiftCardRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "brand": {
            "type": "string",
            "maxLength": 256
          },
          "cardNumber": {
            "type": "string",
            "maxLength": 40
          },
          "cvc": {
            "type": "string",
            "maxLength": 4
          },
          "expirationMonth": {
            "type": "integer",
            "format": "int32"
          },
          "expirationYear": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "brand",
          "cardNumber",
          "cvc"
        ]
      },
      "PaymentInstrumentBalanceRequest": {
        "type": "object",
        "properties": {
          "paymentMethodId": {
            "type": "string",
            "maxLength": 256
          },
          "giftCard": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GiftCardRequest"
              }
            ]
          }
        },
        "required": [
          "giftCard",
          "paymentMethodId"
        ]
      },
      "PaymentInstrumentBalanceResponse": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CurrencyCode"
              }
            ]
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      }
    },
    "parameters": {
      "organizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "style": "simple",
        "explode": false,
        "schema": {
          "$ref": "#/components/schemas/OrganizationId"
        }
      },
      "siteId": {
        "name": "siteId",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/SiteId"
        }
      },
      "currency": {
        "name": "currency",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/CurrencyCode"
        }
      },
      "countryCode": {
        "name": "countryCode",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/CountryCode"
        }
      },
      "zoneId": {
        "name": "zoneId",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/ZoneId"
        }
      },
      "amount": {
        "name": "amount",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "$ref": "#/components/schemas/Amount"
        }
      },
      "sfdcUsid": {
        "name": "sfdc_usid",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "sfdcDwDnt": {
        "name": "sfdc_dw_dnt",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "personalized": {
        "name": "personalized",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "string",
          "enum": [
            "none"
          ]
        }
      },
      "sfdcShopperContext": {
        "name": "sfdc_shopper_context",
        "in": "header",
        "required": false,
        "style": "simple",
        "explode": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "ShopperToken": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token",
            "scopes": {
              "sfcc.shopper-baskets-orders": "Scope granting read-access to shopper basket or orders endpoints",
              "sfcc.shopper-baskets-orders.rw": "Scope granting read and write access to shopper basket or orders endpoints"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/authorize",
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token",
            "scopes": {
              "sfcc.shopper-baskets-orders": "Scope granting read-access to shopper basket or orders endpoints",
              "sfcc.shopper-baskets-orders.rw": "Scope granting read and write access to shopper basket or orders endpoints"
            }
          }
        }
      },
      "ShopperClientContextToken": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://{shortCode}.api.commercecloud.salesforce.com/shopper/auth/v1/organizations/{organizationId}/oauth2/token?hint=client_context",
            "scopes": {
              "sfcc.shopper-baskets-orders": "Scope granting read-access to shopper basket or orders endpoints",
              "sfcc.shopper-baskets-orders.rw": "Scope granting read and write access to shopper basket or orders endpoints"
            }
          }
        }
      }
    }
  }
}
