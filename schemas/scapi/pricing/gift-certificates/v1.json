              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AmOAuth2": [
              "sfcc.gift-certificates.rw"
            ]
          }
        ]
      },
