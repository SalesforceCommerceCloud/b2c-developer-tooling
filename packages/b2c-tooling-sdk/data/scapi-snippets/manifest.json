{
  "version": 1,
  "snippets": [
    {
      "name": "builtin/create-product",
      "description": "Create a basic product, optionally assign it to a storefront catalog category, and verify saved fields and assignment.",
      "effect": "write",
      "file": "create-product.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "catalogId": {
            "type": "string",
            "minLength": 1,
            "description": "Owning catalog for the new product."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Product name in the default locale."
          },
          "offline": {
            "type": "boolean",
            "default": true,
            "description": "Create offline by default; false sets the default online flag."
          },
          "category": {
            "type": "object",
            "description": "Optional assignment target; its catalog may differ from the owning catalog.",
            "properties": {
              "catalogId": {
                "type": "string",
                "minLength": 1
              },
              "categoryId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["catalogId", "categoryId"],
            "additionalProperties": false
          }
        },
        "required": ["productId", "catalogId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/campaign-promotions",
      "description": "Inspect campaign assignments and promotion details in bounded batches.",
      "effect": "read",
      "file": "campaign-promotions.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": ["campaignId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/failed-job-triage",
      "description": "Search failed job executions and inspect a bounded page with continuation.",
      "effect": "read",
      "file": "failed-job-triage.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/job-execution-review",
      "description": "Review job executions in a fixed interval, including successful runs; return compact statuses and continuation.",
      "effect": "read",
      "file": "job-execution-review.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/job-execution-inspect",
      "description": "Inspect one execution and a bounded page of its steps; return the exact WebDAV log path.",
      "effect": "read",
      "file": "job-execution-inspect.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["jobId", "executionId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/code-version-inspect",
      "description": "Identify active and rollback code versions and inspect a bounded page of version metadata.",
      "effect": "read",
      "file": "code-version-inspect.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/site-cartridge-inspect",
      "description": "Inspect site status, catalog, and ordered cartridge paths; check expected cartridge names.",
      "effect": "read",
      "file": "site-cartridge-inspect.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1
          },
          "expectedCartridges": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["siteId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/content-types-inspect",
      "description": "Summarize Page Designer page and component types for a site (regions, attributes); full detail for named type IDs.",
      "effect": "read",
      "file": "content-types-inspect.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "Site whose cartridge path and slots are used."
          },
          "kind": {
            "type": "string",
            "enum": ["page", "component"]
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "description": "Component group, e.g. Content or Layout."
          },
          "typeIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Return full region and attribute detail for these type IDs only."
          }
        },
        "required": ["siteId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/page-push",
      "description": "Validate a Page Designer page body against the site's live page and component types, then create or update it.",
      "effect": "write",
      "file": "page-push.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "Site whose cartridge path and slots are used."
          },
          "page": {
            "type": "object",
            "description": "createOrUpdatePage body: {id, name, typeId, data?, regions: [{id, components: [{id, typeId, data?, regions?}]}]}.",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "typeId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "name", "typeId"]
          },
          "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "Validate only; do not PUT."
          }
        },
        "required": ["siteId", "page"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/slot-configurations-inspect",
      "description": "Search a site's content slot configurations (optionally one slot or context) and return compact status, schedule and content.",
      "effect": "read",
      "file": "slot-configurations-inspect.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "Site whose cartridge path and slots are used."
          },
          "slotId": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "enum": ["global", "category", "folder"]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": ["siteId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/cors-preferences-update",
      "description": "Add or remove one client's CORS origins for a site without replacing other clients, and verify the saved origins.",
      "effect": "write",
      "file": "cors-preferences-update.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "description": "Shopper (SLAS) client ID."
          },
          "add": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Origin such as https://www.example.com"
            }
          },
          "remove": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["siteId", "clientId"],
        "additionalProperties": false
      }
    },
    {
      "name": "builtin/category-rules-run",
      "description": "Evaluate (dry run) or execute a category's dynamic categorization rules, poll status, and return counts with continuation.",
      "effect": "write",
      "file": "category-rules-run.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "catalogId": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "execute": {
            "type": "boolean",
            "default": false,
            "description": "false evaluates matches only; true assigns and unassigns products."
          },
          "statusOnly": {
            "type": "boolean",
            "default": false,
            "description": "Poll the latest run without starting one."
          },
          "polls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "default": 6
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Evaluation productIds page size."
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["catalogId", "categoryId"],
        "additionalProperties": false
      }
    }
  ]
}
