      "name": "builtin/create-product",
      "description": "Basic product creation: select a catalog, optional name and offline state; check existence and verify saved fields.",
      "effect": "write",
      "file": "create-product.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "catalogId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Product name in the default locale."
          },
          "offline": {
            "type": "boolean",
            "default": true,
            "description": "Create offline by default; false sets the default online flag."
          }
        },
        "required": [
          "productId",
          "catalogId"
        ],
        "additionalProperties": false
      }
    },
    {
