{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "customConditions": [
      "development"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
